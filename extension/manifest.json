{
  "manifest_version": 3,
  "name": "GrabBox",
  "version": "0.2.1",
  "description": "Grab any video, audio, image or file into your GrabBox app. The icon lights up when a page has something worth keeping.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GrabBox",
    "default_icon": {
      "16": "icons/icon-faded-16.png",
      "32": "icons/icon-faded-32.png",
      "48": "icons/icon-faded-48.png",
      "128": "icons/icon-faded-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "permissions": ["contextMenus", "tabs", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "grab-current": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Grab the video/audio on this page"
    }
  }
}
